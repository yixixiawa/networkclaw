#!/bin/sh
# NetworkClaw pre-push 钩子：推送标签 = 发布，此时必须带上打包产物。
#
# 为什么只拦标签、不拦分支：
#   日常提交/推送不应该被「4 分钟的构建」拖慢；而打标签意味着对外发布一个版本，
#   这个版本里必须有可用的 exe，否则 clone 下来的人拿到的是没有产物的空壳。
#
# 启用（一次性，写进 .git/config）：
#   git config core.hooksPath .githooks
# 临时跳过：
#   NETWORKCLAW_SKIP_HOOK=1 git push origin main --tags
#
# stdin 格式：<local ref> <local sha> <remote ref> <remote sha>

[ -n "$NETWORKCLAW_SKIP_HOOK" ] && exit 0

has_tag=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/tags/*) has_tag=1 ;;
    esac
done

[ "$has_tag" = "1" ] || exit 0

exe="dist/NetworkClaw/NetworkClaw.exe"

if [ ! -f "$exe" ]; then
    echo ""
    echo "[pre-push] 检测到正在推送标签（发布），但找不到打包产物：$exe"
    echo "[pre-push] 请先执行：powershell -ExecutionPolicy Bypass -File tools/git_release.ps1 -Tag <版本号>"
    echo "[pre-push] 如需强行跳过检查：NETWORKCLAW_SKIP_HOOK=1 git push ..."
    echo ""
    exit 1
fi

if ! git ls-files --error-unmatch "$exe" >/dev/null 2>&1; then
    echo ""
    echo "[pre-push] 打包产物存在但未纳入版本控制（没被提交）：$exe"
    echo "[pre-push] 请先提交产物：.\tools\git_release.ps1 -Tag <版本号> -SkipBuild"
    echo ""
    exit 1
fi

exit 0
