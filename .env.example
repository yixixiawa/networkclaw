# 密钥样例：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不得提交）
# core/providers.py 的 load_providers() 会在启动时自动加载本文件。

# ---- DeepSeek（云端模型）----
# https://platform.deepseek.com 申请；两个内置云端提供方共用此变量
DEEPSEEK_API_KEY=

# ---- VMware 实验机（tools/vm_*.py 使用；不设则用脚本内默认值）----
# VM_VMRUN=D:\vmware\vmrun.exe
# VM_ROOT=D:\virtualmachine
# VM_VMX=D:\virtualmachine\windows10server\路由器.vmx
# VM_GU=yixixiawa
# VM_GP=your-password
